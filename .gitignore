# ==============================================================================
# Git Ignore Rules for WAHA Suite
# ==============================================================================

# Environment Secrets
.env
.env.local
.env.*.local

# Python Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# Editor, OS & Temporary Files
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*~
.idea/
.vscode/

# WhatsApp Live Sessions & Media Data
sessions/
media/
backups/
*.tar.gz
*.zip

# Database files & SQLite runtime locks
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
bot-builder/data/*.db
bot-builder/data/*.sqlite3

# Keep sample / seed flow files
!bot-builder/data/flows_export.json
!bot/rules.json
