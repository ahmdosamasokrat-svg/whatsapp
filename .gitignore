# ==============================================================================
# Git Ignore Rules for WAHA Suite
# ==============================================================================

# Python Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# Editor, OS & Temporary Files
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*~
.idea/
.vscode/

# Ephemeral SQLite runtime locks
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal
