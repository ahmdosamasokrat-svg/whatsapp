# ==============================================================================
# WAHA SUITE CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this file to .env and customize your passwords and keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WAHA API & Security
# ------------------------------------------------------------------------------
# Secret API key used to authenticate all requests to WAHA
WAHA_API_KEY=your_secret_waha_api_key_here

# Credentials for WAHA built-in Web Dashboard & Swagger UI
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=ChangeThisDashboardPassword123!
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=ChangeThisSwaggerPassword123!

# Enable/Disable Dashboards
WAHA_DASHBOARD_ENABLED=true
WHATSAPP_SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 2. WhatsApp Engine & Session
# ------------------------------------------------------------------------------
# Engine: NOWEB (Recommended, fastest, lightweight) | WEBJS | GOWS
WHATSAPP_DEFAULT_ENGINE=NOWEB
WAHA_NAMESPACE=default
WAHA_SESSION=test
WAHA_BASE_URL=http://localhost:2000
WAHA_NOWEB_WA_VERSION=2.3000.1018914486-alpha

# ------------------------------------------------------------------------------
# 3. Logging & Terminal Output
# ------------------------------------------------------------------------------
# Format: PRETTY (Human readable) | JSON (Log aggregators)
WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info
# Set to true to print QR code in docker logs for terminal scanning
WAHA_PRINT_QR=true

# ------------------------------------------------------------------------------
# 4. Media Storage Settings
# ------------------------------------------------------------------------------
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=180
WHATSAPP_FILES_FOLDER=/app/.media

# ------------------------------------------------------------------------------
# 5. Service Port Mappings (Host Ports)
# ------------------------------------------------------------------------------
WAHA_PORT=2000
CONTACTS_UI_PORT=2001
BOT_PORT=2002
BOT_ADMIN_PORT=2003
BOT_BUILDER_PORT=2004

# ------------------------------------------------------------------------------
# 6. Bot Admin Control Panel (Port 2003)
# ------------------------------------------------------------------------------
BOT_ADMIN_PASSWORD=Admin@123
BOT_ADMIN_SECRET=change-this-to-a-random-32-char-secret-key-123456

# ------------------------------------------------------------------------------
# 7. Bot Flow Builder (Port 2004)
# ------------------------------------------------------------------------------
DB_PATH=/app/data/bot.db
