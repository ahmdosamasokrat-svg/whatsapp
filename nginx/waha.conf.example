# ==============================================================================
# Optional Nginx Reverse Proxy Configuration (Port 80 / 443 SSL)
# ==============================================================================
# Place this file in /etc/nginx/conf.d/waha.conf or /etc/nginx/sites-available/
# Replace 'your-domain.com' with your server IP or domain name.
# ==============================================================================

server {
    listen 80;
    server_name your-domain.com;

    client_max_body_size 64M;

    # 1. Main Bot Flow Builder Web Studio (Default root)
    location / {
        proxy_pass http://127.0.0.1:2004;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
    }

    # 2. WAHA Core API & Dashboard
    location /waha/ {
        proxy_pass http://127.0.0.1:2000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Contacts Management UI
    location /contacts/ {
        proxy_pass http://127.0.0.1:2001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Bot Rules Admin
    location /admin/ {
        proxy_pass http://127.0.0.1:2003/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
